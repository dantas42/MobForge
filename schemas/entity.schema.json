{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobforge.dev/schemas/entity.schema.json",
  "title": "MobForge Entity Definition",
  "type": "object",
  "required": ["id"],
  "properties": {
    "schemaVersion": { "type": "integer", "default": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,63}$",
      "description": "Identificador único. O id registrado vira mobforge:<id>."
    },
    "displayName": { "type": "string" },
    "category": {
      "enum": ["animal", "creature", "monster", "boss"],
      "default": "monster"
    },
    "sourceModId": {
      "type": "string",
      "default": "mobforge",
      "description": "Mod dono dos assets (namespace de geo/texturas/animações)."
    },
    "model": { "$ref": "#/$defs/model" },
    "dimensions": { "$ref": "#/$defs/dimensions" },
    "attributes": { "$ref": "#/$defs/attributes" },
    "combat": { "$ref": "#/$defs/combat" },
    "skills": {
      "type": "array",
      "items": { "$ref": "skill.schema.json" }
    },
    "phases": {
      "type": "array",
      "items": { "$ref": "#/$defs/phase" }
    },
    "spawn": { "type": "object" },
    "loot": { "type": "object" }
  },
  "$defs": {
    "model": {
      "type": "object",
      "properties": {
        "geo": { "type": "string", "description": "Caminho relativo a assets/<modid>/ (ex.: geo/foo.geo.json)" },
        "textures": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "animations": { "type": "string" }
      }
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "width": { "type": "number", "default": 0.6 },
        "height": { "type": "number", "default": 1.8 }
      }
    },
    "attributes": {
      "type": "object",
      "properties": {
        "maxHealth": { "type": "number", "default": 20 },
        "armor": { "type": "number", "default": 0 },
        "armorToughness": { "type": "number", "default": 0 },
        "attackDamage": { "type": "number", "default": 2 },
        "movementSpeed": { "type": "number", "default": 0.25 },
        "followRange": { "type": "number", "default": 32 },
        "knockbackResistance": { "type": "number", "default": 0 }
      }
    },
    "combat": {
      "type": "object",
      "properties": {
        "hostile": { "type": "boolean", "default": true },
        "melee": {
          "type": "object",
          "properties": {
            "range": { "type": "number", "default": 3 },
            "damage": { "type": "number", "default": 2 },
            "attackCooldownTicks": { "type": "integer", "default": 20 }
          }
        }
      }
    },
    "phase": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "activation": {
          "type": "array",
          "items": { "type": "object" }
        },
        "modifiers": { "type": "object" },
        "skills": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
